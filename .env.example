NODE_ENV=development
HOST=127.0.0.1
PORT=3002
APP_URL=http://localhost:3002

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.

# SESSION_SECRET: Optional HMAC secret for signing server-side RBAC session tokens.
# If omitted, server.ts generates and persists a random 256-bit secret in <AMS_DATA_DIR>/.session-secret.
SESSION_SECRET=""

# AMS_DATA_DIR: Optional persistent volume/directory for rbac-db.json, app-state.json, and website-published.json.
# Defaults to ./data if omitted.
AMS_DATA_DIR=""

# BOOTSTRAP_DEV_*: Optional first-boot developer provisioning via environment variables (no hardcoded passwords).
# Recommended: generate BOOTSTRAP_DEV_PASSWORD_HASH safely with: npm run auth:hash
# Alternative (for encrypted Secret Manager when CLI is unavailable): set BOOTSTRAP_DEV_PASSWORD (min. 8 chars).
BOOTSTRAP_DEV_USERNAME="dev.admin"
BOOTSTRAP_DEV_PASSWORD_HASH=""
BOOTSTRAP_DEV_PASSWORD=""
BOOTSTRAP_DEV_FULLNAME="Developer Utama AMS"
BOOTSTRAP_DEV_EMAIL=""
BOOTSTRAP_DEV_ROLE_ID="it_admin"

# INITIAL_SETUP_TOKEN: Optional secret token required by the one-time Web Setup Wizard (/api/auth/setup).
INITIAL_SETUP_TOKEN=""

# PostgreSQL (dibaca backend/config.ts). Jalankan npm run db:local:init untuk menghasilkan .env dengan password acak.
DATABASE_URL=postgresql://ams_app:CHANGE_ME@127.0.0.1:5433/ams_local
# disable hanya untuk loopback; gunakan verify-full untuk database remote.
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000

# Tetap kosong sampai autentikasi publikasi server disiapkan; jangan gunakan VITE_*.
AMS_ADMIN_TOKEN=
