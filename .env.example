# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional HMAC secret for signing server-side RBAC session tokens.
# If omitted, server.ts generates and persists a random 256-bit secret in <AMS_DATA_DIR>/.session-secret.
SESSION_SECRET=""

# AMS_DATA_DIR: Optional persistent volume/directory for rbac-db.json, app-state.json, and website-published.json.
# Defaults to ./data if omitted (e.g. C:\AMS\Data on Windows Server VPS, /var/lib/ams-data on Linux).
AMS_DATA_DIR=""

# AMS_DB_DRIVER: Database mode ("firebase" for staging/AI Studio, or "pocketbase" when restored to local/VPS PocketBase).
# Archived PocketBase settings live in archive/pocketbase-legacy/pocketbase-config.json.
AMS_DB_DRIVER="firebase"

# DEPLOYMENT_ENV & VITE_DEPLOYMENT_ENV: Set both to "staging" to override firebase-applet-config.json
# with a separate Firebase Staging project (use .env.staging + `npm run build:staging` on Windows VPS).
DEPLOYMENT_ENV=""
VITE_DEPLOYMENT_ENV=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID="ai-studio-amsintegratedsys-a6cc9862-667b-4eea-be94-96098a1c9439"
VITE_FIREBASE_ADMIN_EMAIL=""

# Firebase Admin SDK (Server-Side / Windows VPS):
# Arahkan ke file Service Account JSON (mis. C:\AMS\Secrets\firebase-service-account.json)
# atau isi JSON/Base64 di FIREBASE_SERVICE_ACCOUNT_JSON untuk verifikasi token & Firestore server-to-server.
FIRESTORE_DATABASE_ID="ai-studio-amsintegratedsys-a6cc9862-667b-4eea-be94-96098a1c9439"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-amsintegratedsys-a6cc9862-667b-4eea-be94-96098a1c9439"
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# DeepL website translation (optional; server-side only, never expose as VITE_*)
DEEPL_AUTH_KEY=""
DEEPL_API_URL="https://api-free.deepl.com"

# BOOTSTRAP_DEV_*: Optional first-boot developer provisioning via environment variables (no hardcoded passwords).
# Recommended: generate BOOTSTRAP_DEV_PASSWORD_HASH safely with: npm run auth:hash
# Alternative (for encrypted Secret Manager when CLI is unavailable): set BOOTSTRAP_DEV_PASSWORD (min. 8 chars).
BOOTSTRAP_DEV_USERNAME="dev.admin"
BOOTSTRAP_DEV_PASSWORD_HASH=""
BOOTSTRAP_DEV_PASSWORD=""
BOOTSTRAP_DEV_FULLNAME="Langgo Bramandityo"
BOOTSTRAP_DEV_EMAIL="antraderyll@gmail.com"
BOOTSTRAP_DEV_ROLE_ID="Developer & IT Support"
FIREBASE_ADMIN_EMAILS="cloud.ams2026@gmail.com,antraderyll@gmail.com"

# INITIAL_SETUP_TOKEN: Optional secret token required by the one-time Web Setup Wizard (/api/auth/setup).
INITIAL_SETUP_TOKEN=""
